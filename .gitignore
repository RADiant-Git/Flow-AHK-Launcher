# ========================================================
#  Байткод и кэши Python
# ========================================================
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ========================================================
#  Виртуальные окружения
# ========================================================
.venv/
venv/
env/
ENV/

# ========================================================
#  Данные плагина
# ========================================================
# С версии 1.0.0 runtime.ahk, session.json и modules.json лежат вне папки
# плагина — в Settings/Plugins/FlowKey Manager каталога данных Flow Launcher
# (см. core/config.py). Записи ниже остаются страховкой для запуска без
# Flow Launcher, когда используется запасной путь рядом с кодом.
/runtime.ahk
/session.json

# Личные правила. В репозитории только шаблон modules.json.example:
# публиковать чужие бинды как бинды по умолчанию нельзя.
/modules.json

# Файловые блокировки и временные файлы атомарной записи
*.lock
*.tmp
*.bak
/flowkey-check-*.ahk

